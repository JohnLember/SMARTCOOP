# MySQL connection.
# XAMPP's default is user=root with no password. That is fine on a laptop and
# NOT fine in production: create a dedicated database user that owns only the
# `smartcoop` schema and holds only SELECT/INSERT/UPDATE/DELETE on it — no
# GRANT, no access to other databases, no root.
DATABASE_URL="mysql://root:@localhost:3306/smartcoop"

# Auth. The server REFUSES TO START if this is missing, shorter than 32
# characters, or still the placeholder below — an unset secret used to fall back
# to a hardcoded string, which let anyone forge an ADMIN token.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Server
PORT=4000

# Browser origins allowed to call this API, comma-separated. There is no
# wildcard: leaving this blank refuses ALL cross-origin browser requests rather
# than allowing any site to read member data with a victim's token.
CORS_ORIGIN="http://localhost:5173"

# Set to 1 only when the app runs behind a reverse proxy (nginx, a PaaS router).
# It makes Express read the client IP from X-Forwarded-For so rate limiting
# buckets per client instead of lumping everyone under the proxy's address.
# Leave unset when the app is exposed directly — otherwise clients can spoof the
# header and slip the rate limiter.
# TRUST_PROXY=1

# Set in production. Switches request logging to the combined access-log format.
# NODE_ENV=production
